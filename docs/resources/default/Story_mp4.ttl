@prefix : <http://www.purl.org/storytel/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Story_mp4 a owl:Class ;
    rdfs:label "Anonymized Video Manifestation"@en ;
    dc:title "Anonymized Video Manifestation"@en ;
    rdfs:comment "Manifestation of an Anonymized Video in mp4 file format."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R4_embodies ;
            owl:someValuesFrom :Story ],
        lrmoo:F3_Manifestation .

