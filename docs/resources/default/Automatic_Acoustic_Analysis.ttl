@prefix : <http://www.purl.org/storytel/> .
@prefix crmdig: <http://www.cidoc-crm.org/extensions/crmdig/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Automatic_Acoustic_Analysis a owl:Class ;
    rdfs:label "Automatic Acoustic Analysis"@en ;
    dc:title "Automatic Acoustic Analysis"@en ;
    rdfs:comment "Automatic annotation event in which the pipeline runs Praat on a segment of the Story to produce acoustic annotations."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L23_used_software_or_firmware ;
            owl:someValuesFrom :Praat ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L48_created_annotation ;
            owl:someValuesFrom :Acoustic_Annotation ],
        :Automatic_Annotation .

