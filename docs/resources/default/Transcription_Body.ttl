@prefix : <http://www.purl.org/storytel/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Transcription_Body a owl:Class ;
    rdfs:label "Transcription Body"@en ;
    dc:title "Transcription Body"@en ;
    rdfs:comment "Text of the automatic transcription of a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Textual_Annotation_Body .

