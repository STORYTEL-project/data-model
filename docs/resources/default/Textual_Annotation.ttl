@prefix : <http://www.purl.org/storytel/> .
@prefix crmdig: <http://www.cidoc-crm.org/extensions/crmdig/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Textual_Annotation a owl:Class ;
    rdfs:label "Textual Annotation"@en ;
    dc:title "Textual Annotation"@en ;
    rdfs:comment "Annotation carrying text (transcription, translation or glossing) for a segment of an Anonymized Story."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L43_annotates ;
            owl:someValuesFrom :Anonymized_Story ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Textual_Annotation_Body ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasTarget ;
            owl:someValuesFrom :Anonymized_Story_Segment ],
        :Annotation .

