@prefix : <http://www.purl.org/storytel/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Transcription_Annotation a owl:Class ;
    rdfs:label "Transcription Annotation"@en ;
    dc:title "Transcription Annotation"@en ;
    rdfs:comment "Annotation whose body is the transcription of a segment of an Anonymized Story."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Transcription_Body ],
        :Textual_Annotation .

