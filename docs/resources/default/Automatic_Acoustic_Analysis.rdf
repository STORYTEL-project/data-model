<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dc="http://purl.org/dc/elements/1.1/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Automatic_Acoustic_Analysis">
    <rdfs:label xml:lang="en">Automatic Acoustic Analysis</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b33"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Automatic_Annotation"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b34"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Automatic annotation event in which the pipeline runs Praat on a segment of the Story to produce acoustic annotations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <dc:title xml:lang="en">Automatic Acoustic Analysis</dc:title>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b34">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Acoustic_Annotation"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/L48_created_annotation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b33">
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Praat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/L23_used_software_or_firmware"/>
  </rdf:Description>
</rdf:RDF>
