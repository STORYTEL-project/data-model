@prefix : <http://www.purl.org/storytel/> .
@prefix cidoc-crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.cidoc-crm.org/extensions/crmdig/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix type: <http://www.purl.org/storytel/type/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty ;
    rdfs:label "Creator"@en ;
    dc:title "Creator"@en ;
    rdfs:comment "Entity primarily responsible for making the resource; used here to record the author of the ontology."@en ;
    rdfs:isDefinedBy dc: .

dc:description a owl:AnnotationProperty ;
    rdfs:label "Description"@en ;
    dc:title "Description"@en ;
    rdfs:comment "An account of the resource; used here to describe the ontology and its purpose."@en ;
    rdfs:isDefinedBy dc: .

dc:language a owl:AnnotationProperty ;
    rdfs:label "Language"@en ;
    dc:title "Language"@en ;
    rdfs:comment "The language of the resource; used here to state the language in which the ontology is expressed."@en ;
    rdfs:isDefinedBy dc: .

dc:title a owl:AnnotationProperty ;
    rdfs:label "Title"@en ;
    dc:title "Title"@en ;
    rdfs:comment "A name given to the resource; used here to provide a human-readable title for ontology terms."@en ;
    rdfs:isDefinedBy dc: .

:Amplitude_Annotation a owl:Class ;
    rdfs:label "Amplitude Annotation"@en ;
    dc:title "Amplitude Annotation"@en ;
    rdfs:comment "Acoustic annotation holding the Amplitude (waveform) of a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Acoustic_Annotation .

:Anonymized_Story_Creation a owl:Class ;
    rdfs:label "Anonymized Story Creation"@en ;
    dc:title "Anonymized Story Creation"@en ;
    rdfs:comment "Event in which an Anonymized Story is created as a formal derivation of a Story, using software based on an LLM."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R17_created ;
            owl:someValuesFrom :Anonymized_Story ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L21_used_as_derivation_source ;
            owl:someValuesFrom :Story ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L22_created_derivative ;
            owl:someValuesFrom :Anonymized_Story ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L23_used_software_or_firmware ;
            owl:someValuesFrom :Software_Based_On_LLM ],
        lrmoo:F28_Expression_Creation,
        crmdig:D3_Formal_Derivation .

:Anonymized_Story_Manifestation a owl:Class ;
    rdfs:label "Anonymized Story Manifestation"@en ;
    dc:title "Anonymized Story Manifestation"@en ;
    rdfs:comment "Manifestation of an Anonymized Story in mp4 file format."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R4_embodies ;
            owl:someValuesFrom :Anonymized_Story ],
        lrmoo:F3_Manifestation .

:Automatic_Glossing a owl:Class ;
    rdfs:label "Automatic Glossing"@en ;
    dc:title "Automatic Glossing"@en ;
    rdfs:comment "Automatic annotation event in which the pipeline glosses a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L48_created_annotation ;
            owl:someValuesFrom :Glossing_Annotation ],
        :Automatic_Annotation .

:Automatic_Transcription a owl:Class ;
    rdfs:label "Automatic Transcription"@en ;
    dc:title "Automatic Transcription"@en ;
    rdfs:comment "Automatic annotation event in which the pipeline transcribes a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L48_created_annotation ;
            owl:someValuesFrom :Transcription_Annotation ],
        :Automatic_Annotation .

:Automatic_Translation a owl:Class ;
    rdfs:label "Automatic Translation"@en ;
    dc:title "Automatic Translation"@en ;
    rdfs:comment "Automatic annotation event in which the pipeline translates a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L48_created_annotation ;
            owl:someValuesFrom :Translation_Annotation ],
        :Automatic_Annotation .

:Conversational_Storytelling_Session a owl:Class ;
    rdfs:label "Conversational Storytelling session"@en ;
    dc:title "Conversational Storytelling session"@en ;
    rdfs:comment "Abstract work corresponding to a session of conversational storytelling, realised in the Full Video, the Story and the Anonymized Story."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R3_is_realised_in ;
            owl:someValuesFrom :Anonymized_Story ],
        [ a owl:Restriction ;
            owl:onProperty lrmoo:R3_is_realised_in ;
            owl:someValuesFrom :Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty lrmoo:R3_is_realised_in ;
            owl:someValuesFrom :Story ],
        lrmoo:F1_Work .

:Frequency_Annotation a owl:Class ;
    rdfs:label "Frequency Annotation"@en ;
    dc:title "Frequency Annotation"@en ;
    rdfs:comment "Acoustic annotation holding the Frequency of a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Acoustic_Annotation .

:Full_Video_Creation a owl:Class ;
    rdfs:label "Full Video Creation"@en ;
    dc:title "Full Video Creation"@en ;
    rdfs:comment "Event of recording a Full Video, carried out by a Student Recording with a Group of Participants, at a Place of Recording and on a Smartphone."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R17_created ;
            owl:someValuesFrom :Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P11_had_participant ;
            owl:someValuesFrom :Group_Of_Participants ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P14_carried_out_by ;
            owl:someValuesFrom :Student_Recording ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P7_took_place_at ;
            owl:someValuesFrom :Place_Of_Recording ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L12_happened_on_device ;
            owl:someValuesFrom :Smartphone ],
        lrmoo:F28_Expression_Creation .

:Full_Video_Manifestation a owl:Class ;
    rdfs:label "Full Video Manifestation"@en ;
    dc:title "Full Video Manifestation"@en ;
    rdfs:comment "Manifestation of a Full Video in mp4 file format."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R4_embodies ;
            owl:someValuesFrom :Full_Video ],
        lrmoo:F3_Manifestation .

:Pitch_Annotation a owl:Class ;
    rdfs:label "F0 Annotation"@en ;
    dc:title "F0 Annotation"@en ;
    rdfs:comment "Acoustic annotation holding the fundamental frequency (F0, in Hz) contour of a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Acoustic_Annotation .

:Story_Creation a owl:Class ;
    rdfs:label "Anonymized Video Creation"@en ;
    dc:title "Anonymized Video Creation"@en ;
    rdfs:comment "Event in which an Anonymized Video is created by a anonymization pipeline based on LLMs."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R17_created ;
            owl:someValuesFrom :Story ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L21_used_as_derivation_source ;
            owl:someValuesFrom :Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L22_created_derivative ;
            owl:someValuesFrom :Story ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L23_used_software_or_firmware ;
            owl:someValuesFrom :Software_Based_On_LLM ],
        lrmoo:F28_Expression_Creation .

:Story_Manifestation a owl:Class ;
    rdfs:label "Anonymized Video Manifestation"@en ;
    dc:title "Story Manifestation"@en ;
    rdfs:comment "Manifestation of a Story in mp4 file format."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R4_embodies ;
            owl:someValuesFrom :Story ],
        lrmoo:F3_Manifestation .

:pitch_ceiling a owl:DatatypeProperty ;
    rdfs:label "pitch ceiling"@en ;
    dc:title "pitch ceiling"@en ;
    rdfs:comment "Upper bound of the F0 search range used in the Praat analysis, in Hz."@en ;
    rdfs:domain :Automatic_Acoustic_Analysis ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:decimal .

:pitch_floor a owl:DatatypeProperty ;
    rdfs:label "pitch floor"@en ;
    dc:title "pitch floor"@en ;
    rdfs:comment "Lower bound of the F0 search range used in the Praat analysis, in Hz."@en ;
    rdfs:domain :Automatic_Acoustic_Analysis ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:decimal .

:time_step a owl:DatatypeProperty ;
    rdfs:label "time step"@en ;
    dc:title "time step"@en ;
    rdfs:comment "Time step between analysis frames used in the Praat analysis, in seconds."@en ;
    rdfs:domain :Automatic_Acoustic_Analysis ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:decimal .

cidoc-crm:P107_has_current_member a owl:ObjectProperty .

:Acoustic_Annotation_Body a owl:Class ;
    rdfs:label "Acoustic Annotation Body"@en ;
    dc:title "Acoustic Annotation Body"@en ;
    rdfs:comment "Output of the acoustic analysis of a segment of the Story, stored as a digital object (e.g. an F0 data file or a waveform or spectrogram image) and not as text. Because it is computed on the non-anonymized voice it may allow speaker identification."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crmdig:D1_Digital_Object,
        :Annotation_Body .

:Age_Of_The_Participants a owl:Class ;
    rdfs:label "Age of the Participants"@en ;
    dc:title "Age of the Participants"@en ;
    rdfs:comment "Dimension expressing the age of the participants in a group, expressed as an integer value between 18 and 65."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P90_has_value ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions ( [ xsd:minInclusive 18 ] [ xsd:maxInclusive 65 ] ) ] ],
        cidoc-crm:E54_Dimension .

:Anonymized_Story_Segment a owl:Class ;
    rdfs:label "Segment of Anonymized Story"@en ;
    dc:title "Segment of Anonymized Story"@en ;
    rdfs:comment "Temporal segment of an Anonymized Story, e.g. 00:12:03-00:12:47." ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oa:hasSelector ;
            owl:someValuesFrom :Media_Fragment_Selector ],
        :Media_Segment,
        oa:SpecificResource .

:Duration_Of_Full_Video a owl:Class ;
    rdfs:label "Duration of Full Video"@en ;
    dc:title "Duration of Full Video"@en ;
    rdfs:comment "Dimension expressing the total duration of a Full Video, as an xsd:duration value."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P90_has_value ;
            owl:someValuesFrom xsd:duration ],
        cidoc-crm:E54_Dimension .

:Glossing_Body a owl:Class ;
    rdfs:label "Glossing Body"@en ;
    dc:title "Glossing Body"@en ;
    rdfs:comment "Interlinear gloss of a segment, produced automatically from its transcription."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Textual_Annotation_Body .

:Group_Of_Participants a owl:Class ;
    rdfs:label "Group of Participants"@en ;
    dc:title "Group of Participants"@en ;
    rdfs:comment "Group of student participants taking part in a conversational storytelling session, characterised by their number and age."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P107_has_current_member ;
            owl:someValuesFrom :Student_Participant ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P43_has_dimension ;
            owl:someValuesFrom :Age_Of_The_Participants ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P43_has_dimension ;
            owl:someValuesFrom :Number_of_Participants ],
        cidoc-crm:E74_Group .

:Number_of_Participants a owl:Class ;
    rdfs:label "Number of Participants"@en ;
    dc:title "Number of Participants"@en ;
    rdfs:comment "Dimension expressing the number of participants in a group, as an integer value."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P90_has_value ;
            owl:someValuesFrom xsd:integer ],
        cidoc-crm:E54_Dimension .

:Place_Of_Recording a owl:Class ;
    rdfs:label "Place of Recording"@en ;
    dc:title "Place of Recording"@en ;
    rdfs:comment "Place where a Full Video is recorded."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf cidoc-crm:E53_Place .

:Praat a owl:Class ;
    rdfs:label "Praat"@en ;
    dc:title "Praat"@en ;
    rdfs:comment "Praat software used for the acoustic analysis (pitch, amplitude, frequency). Use one individual per version."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crmdig:D14_Software .

:Smartphone a owl:Class ;
    rdfs:label "Smartphone"@en ;
    dc:title "Smartphone"@en ;
    rdfs:comment "Digital device (smartphone) used to record the Full Video."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crmdig:D8_Digital_Device .

:Story_Segment a owl:Class ;
    rdfs:label "Segment of Story"@en ;
    dc:title "Segment of Story"@en ;
    rdfs:comment "Temporal segment of a Story (the source of the Anonymized Story, i.e. before voice and body anonymisation), e.g. 00:12:03-00:12:47."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Media_Segment .

:Storytel_AI_Assisted_Pipeline a owl:Class ;
    rdfs:label "Storytel AI-assisted pipeline"@en ;
    dc:title "Storytel AI-assisted pipeline"@en ;
    rdfs:comment "Software pipeline developed in the STORYTEL project that uses AI techniques to automatically annotate stories."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crmdig:D14_Software .

:Student_Participant a owl:Class ;
    rdfs:label "Student Participant"@en ;
    dc:title "Student Participant"@en ;
    rdfs:comment "Person, a student, who participates in a conversational storytelling session."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf cidoc-crm:E21_Person .

:Student_Recording a owl:Class ;
    rdfs:label "Student Recording"@en ;
    dc:title "Student Recording"@en ;
    rdfs:comment "Actor (student) who records the Full Video."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf cidoc-crm:E39_Actor .

:Transcription_Body a owl:Class ;
    rdfs:label "Transcription Body"@en ;
    dc:title "Transcription Body"@en ;
    rdfs:comment "Text of the automatic transcription of a segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Textual_Annotation_Body .

:Translation_Body a owl:Class ;
    rdfs:label "Translation Body"@en ;
    dc:title "Translation Body"@en ;
    rdfs:comment "Text of the automatic translation of a segment. Its target language is given with P72 has language."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Textual_Annotation_Body .

type:Anonymized_Story a cidoc-crm:E55_Type,
        owl:NamedIndividual ;
    rdfs:label "Anonymized Story"@en ;
    dc:title "Anonymized Story"@en ;
    rdfs:comment "Type (E55 Type) used to classify digital objects as Anonymized Stories."@en ;
    rdfs:isDefinedBy type: .

type:Full_Video a cidoc-crm:E55_Type,
        owl:NamedIndividual ;
    rdfs:label "Full Video"@en ;
    dc:title "Full Video"@en ;
    rdfs:comment "Type (E55 Type) used to classify digital objects as Full Videos."@en ;
    rdfs:isDefinedBy type: .

type:Story a cidoc-crm:E55_Type,
        owl:NamedIndividual ;
    rdfs:label "Anonymized Video"@en ;
    dc:title "Anonymized Video"@en ;
    rdfs:comment "Type (E55 Type) used to classify digital objects as Anonymized Video."@en ;
    rdfs:isDefinedBy type: .

rdf:value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    dc:title "value"@en ;
    rdfs:comment "RDF property giving the literal value of a structured resource, here the media fragment expression of a selector."@en ;
    rdfs:isDefinedBy rdf: .

oa:Annotation a owl:Class ;
    rdfs:label "Annotation"@en ;
    dc:title "Annotation"@en ;
    rdfs:comment "Web Annotation class: a typed relationship between a body (the content) and a target (the annotated resource)."@en ;
    rdfs:isDefinedBy oa: .

oa:FragmentSelector a owl:Class ;
    rdfs:label "Fragment Selector"@en ;
    dc:title "Fragment Selector"@en ;
    rdfs:comment "Web Annotation class: a Selector that describes a segment of a resource through a fragment identifier."@en ;
    rdfs:isDefinedBy oa: .

oa:TextualBody a owl:Class ;
    rdfs:label "Textual Body"@en ;
    dc:title "Textual Body"@en ;
    rdfs:comment "Web Annotation class: an embedded textual resource used as the body of an Annotation."@en ;
    rdfs:isDefinedBy oa: .

:End_Of_The_Full_Video a owl:Class ;
    rdfs:label "End of the Anonymized Story"@en ;
    dc:title "End of the Anonymized Story"@en ;
    rdfs:comment "Dimension expressing the end time of an Anonymized Story, as an xsd:time value."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P90_has_value ;
            owl:someValuesFrom xsd:time ],
        cidoc-crm:E54_Dimension .

:Glossing_Annotation a owl:Class ;
    rdfs:label "Glossing Annotation"@en ;
    dc:title "Glossing Annotation"@en ;
    rdfs:comment "Annotation whose body is the interlinear gloss of a segment of an Anonymized Story, based on the transcription of that segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :is_based_on_transcription ;
            owl:someValuesFrom :Transcription_Annotation ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Glossing_Body ],
        :Textual_Annotation .

:Media_Fragment_Selector a owl:Class ;
    rdfs:label "Media Fragment Selector"@en ;
    dc:title "Media Fragment Selector"@en ;
    rdfs:comment "Media Fragment URI selecting the segment, e.g. t=723,767." ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdf:value ;
            owl:someValuesFrom xsd:duration ],
        oa:FragmentSelector .

:Start_Of_The_Full_Video a owl:Class ;
    rdfs:label "Start of the Anonymized Story"@en ;
    dc:title "Start of the Anonymized Story"@en ;
    rdfs:comment "Dimension expressing the start time of an Anonymized Story, as an xsd:time value."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P90_has_value ;
            owl:someValuesFrom xsd:time ],
        cidoc-crm:E54_Dimension .

:Translation_Annotation a owl:Class ;
    rdfs:label "Translation Annotation"@en ;
    dc:title "Translation Annotation"@en ;
    rdfs:comment "Annotation whose body is the translation of a segment of an Anonymized Story, based on the transcription of that segment."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :is_based_on_transcription ;
            owl:someValuesFrom :Transcription_Annotation ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Translation_Body ],
        :Textual_Annotation .

:is_based_on_transcription a owl:ObjectProperty ;
    rdfs:label "is based on transcription"@en ;
    dc:title "is based on transcription"@en ;
    rdfs:comment "Links a translation or glossing annotation to the transcription annotation it was derived from."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Glossing_Annotation :Translation_Annotation ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Transcription_Annotation .

xsd:duration a rdfs:Datatype .

xsd:time a rdfs:Datatype .

oa:SpecificResource a owl:Class ;
    rdfs:label "Specific Resource"@en ;
    dc:title "Specific Resource"@en ;
    rdfs:comment "Web Annotation class: a part or a particular state of a resource, identified through a source and a selector."@en ;
    rdfs:isDefinedBy oa: .

oa:hasSelector a owl:ObjectProperty ;
    rdfs:label "has selector"@en ;
    dc:title "has selector"@en ;
    rdfs:comment "Web Annotation property linking a Specific Resource to the Selector that identifies the segment of the source."@en ;
    rdfs:isDefinedBy oa: .

:Annotation a owl:Class ;
    rdfs:label "Annotation"@en ;
    dc:title "Annotation "@en ;
    rdfs:comment "Annotation object attached to a segment of a Story or of an Anonymized Story, whose body carries the annotation content (transcription, translation, glossing, acoustic analysis). It is created using the Storytel AI pipeline"@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L43_annotates ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Anonymized_Story :Story ) ] ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Annotation_Body ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasTarget ;
            owl:someValuesFrom :Media_Segment ],
        crmdig:D29_Annotation_Object,
        oa:Annotation .

:Annotation_Body a owl:Class ;
    rdfs:label "Annotation Body"@en ;
    dc:title "Annotation Body"@en ;
    rdfs:comment "Content of an annotation. It is either textual (transcription, translation, glossing) or acoustic (output of the acoustic analysis)." ;
    rdfs:isDefinedBy : .

:Automatic_Acoustic_Analysis a owl:Class ;
    rdfs:label "Automatic Acoustic Analysis"@en ;
    dc:title "Automatic Acoustic Analysis"@en ;
    rdfs:comment "Automatic annotation event in which the pipeline runs Praat on a segment of the Story to produce acoustic annotations."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L23_used_software_or_firmware ;
            owl:someValuesFrom :Praat ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L48_created_annotation ;
            owl:someValuesFrom :Acoustic_Annotation ],
        :Automatic_Annotation .

:Media_Segment a owl:Class ;
    rdfs:label "Media Segment"@en ;
    dc:title "Media Segment"@en ;
    rdfs:comment "Temporal segment of a time-based resource, identified by a media fragment selector. Generalises the segments of the Story and of the Anonymized Story."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oa:hasSelector ;
            owl:someValuesFrom :Media_Fragment_Selector ],
        oa:SpecificResource .

:Software_Based_On_LLM a owl:Class ;
    rdfs:label "LLM Software"@en ;
    dc:title "LLM Software"@en ;
    rdfs:comment "Software based on a Large Language Model (LLM), used to produce the Anonymized Story from the Story."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crmdig:D14_Software .

xsd:decimal a rdfs:Datatype .

oa:hasTarget a owl:ObjectProperty ;
    rdfs:label "has target"@en ;
    dc:title "has target"@en ;
    rdfs:comment "Web Annotation property linking an Annotation to the resource (or segment of a resource) being annotated."@en ;
    rdfs:isDefinedBy oa: .

:Acoustic_Annotation a owl:Class ;
    rdfs:label "Acoustic Annotation"@en ;
    dc:title "Acoustic Annotation"@en ;
    rdfs:comment "Annotation holding the result of an acoustic analysis (Praat) of a segment of the Story. It is computed on the original, non-anonymized audio, so it may contain speaker-identifying information and should be handled according to the project data-protection policy."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L43_annotates ;
            owl:someValuesFrom :Story ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Acoustic_Annotation_Body ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasTarget ;
            owl:someValuesFrom :Story_Segment ],
        :Annotation ;
    owl:disjointWith :Textual_Annotation .

:Automatic_Annotation a owl:Class ;
    rdfs:label "Automatic Annotation"@en ;
    dc:title "Automatic Annotation"@en ;
    rdfs:comment "Annotation event carried out automatically by the Storytel AI-assisted pipeline, producing an Annotation."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L23_used_software_or_firmware ;
            owl:someValuesFrom :Storytel_AI_Assisted_Pipeline ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L48_created_annotation ;
            owl:someValuesFrom :Annotation ],
        crmdig:D30_Annotation_Event .

:Textual_Annotation a owl:Class ;
    rdfs:label "Textual Annotation"@en ;
    dc:title "Textual Annotation"@en ;
    rdfs:comment "Annotation carrying text (transcription, translation or glossing) for a segment of an Anonymized Story."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty crmdig:L43_annotates ;
            owl:someValuesFrom :Anonymized_Story ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Textual_Annotation_Body ],
        [ a owl:Restriction ;
            owl:onProperty oa:hasTarget ;
            owl:someValuesFrom :Anonymized_Story_Segment ],
        :Annotation .

:Textual_Annotation_Body a owl:Class ;
    rdfs:label "Textual Annotation Body"@en ;
    dc:title "Textual Annotation Body"@en ;
    rdfs:comment "Annotation body consisting of text (transcription, translation or glossing)."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Annotation_Body,
        oa:TextualBody .

:Transcription_Annotation a owl:Class ;
    rdfs:label "Transcription Annotation"@en ;
    dc:title "Transcription Annotation"@en ;
    rdfs:comment "Annotation whose body is the transcription of a segment of an Anonymized Story."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oa:hasBody ;
            owl:someValuesFrom :Transcription_Body ],
        :Textual_Annotation .

oa:hasBody a owl:ObjectProperty ;
    rdfs:label "has body"@en ;
    dc:title "has body"@en ;
    rdfs:comment "Web Annotation property linking an Annotation to the resource that carries its content (e.g. the transcribed text)."@en ;
    rdfs:isDefinedBy oa: .

:Full_Video a owl:Class ;
    rdfs:label "Full Video"@en ;
    dc:title "Full Video"@en ;
    rdfs:comment "Full video registered by a student for the scope of the project on the study of Conversational Storytelling. Duration represents the duration of the video, while start and end time represents the extremities" ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P43_has_dimension ;
            owl:someValuesFrom :Duration_Of_Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P43_has_dimension ;
            owl:someValuesFrom :End_Of_The_Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P43_has_dimension ;
            owl:someValuesFrom :Start_Of_The_Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P72_has_language ;
            owl:someValuesFrom cidoc-crm:E56_Language ],
        [ a owl:Restriction ;
            owl:hasValue type:Full_Video ;
            owl:onProperty cidoc-crm:P2_has_type ],
        lrmoo:F2_Expression,
        crmdig:D1_Digital_Object ;
    owl:disjointWith [ a owl:Class ;
            owl:unionOf ( :Anonymized_Story :Story ) ] .

:Anonymized_Story a owl:Class ;
    rdfs:label "Anonymized Story"@en ;
    dc:title "Anonymized Story"@en ;
    rdfs:comment "Anonymized version of the clipped story using AI techniques. Anonymization involves voice and body." ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R76_is_derivative_of ;
            owl:someValuesFrom :Story ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P43_has_dimension ;
            owl:someValuesFrom :End_Of_The_Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty cidoc-crm:P43_has_dimension ;
            owl:someValuesFrom :Start_Of_The_Full_Video ],
        [ a owl:Restriction ;
            owl:onProperty crmdig:L23_used_software_or_firmware ;
            owl:someValuesFrom :Software_Based_On_LLM ],
        [ a owl:Restriction ;
            owl:hasValue type:Anonymized_Story ;
            owl:onProperty cidoc-crm:P2_has_type ],
        lrmoo:F2_Expression,
        crmdig:D1_Digital_Object ;
    owl:disjointWith [ a owl:Class ;
            owl:unionOf ( :Full_Video :Story ) ] .

:Story a owl:Class ;
    rdfs:label "Anonymized Video"@en ;
    dc:title "Anonymized Video"@en ;
    rdfs:comment "Anonymized version of the full video" ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lrmoo:R76_is_derivative_of ;
            owl:someValuesFrom :Full_Video ],
        [ a owl:Restriction ;
            owl:hasValue type:Story ;
            owl:onProperty cidoc-crm:P2_has_type ],
        lrmoo:F2_Expression,
        crmdig:D1_Digital_Object ;
    owl:disjointWith [ a owl:Class ;
            owl:unionOf ( :Anonymized_Story :Full_Video ) ] .

: a owl:Ontology ;
    rdfs:label "Storytel" ;
    dc:creator "Giorgia Crosilla" ;
    dc:description "Storytel is the ontology of the european funded project Storytel. Its goal is to map the relationship between Full Video, Anonymized Video and Anonymized Story re-using existing ontologies and implementing some ad-hoc classes." ;
    dc:language "English" ;
    dc:title "Storytel" ;
    owl:imports <http://cidoc-crm.org/extensions/lrmoo/owl/1.0/>,
        <http://www.cidoc-crm.org/cidoc-crm/owl/7.1.3/>,
        <http://www.cidoc-crm.org/extensions/crmdig/owl/5.0/> .

