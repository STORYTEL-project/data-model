>
  <rdf:Description rdf:about="http://www.purl.org/storytel/End_Of_The_Full_Video">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E54_Dimension"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b44"/>
    <dc:title xml:lang="en">End of the Anonymized Story</dc:title>
    <rdfs:comment xml:lang="en">Dimension expressing the end time of an Anonymized Story, as an xsd:time value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">End of the Anonymized Story</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:title xml:lang="en">Description</dc:title>
    <rdfs:comment xml:lang="en">An account of the resource; used here to describe the ontology and its purpose.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/elements/1.1/"/>
    <rdfs:label xml:lang="en">Description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/D29_Annotation_Object"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b13"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b17"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b18"/>
    <dc:title xml:lang="en">Annotation </dc:title>
    <rdfs:comment xml:lang="en">Annotation object attached to a segment of a Story or of an Anonymized Story, whose body carries the annotation content (transcription, translation, glossing, acoustic analysis). It is created using the Storytel AI pipeline</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Annotation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R17_created"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Anonymized_Story"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b71">
    <rdf:first rdf:resource="http://www.purl.org/storytel/Anonymized_Story"/>
    <rdf:rest rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b72"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b53">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R17_created"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Full_Video"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b11">
    <rdf:first rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b9"/>
    <rdf:rest rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b12"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Automatic_Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/D30_Annotation_Event"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b35"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b36"/>
    <dc:title xml:lang="en">Automatic Annotation</dc:title>
    <rdfs:comment xml:lang="en">Annotation event carried out automatically by the Storytel AI-assisted pipeline, producing an Annotation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Automatic Annotation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Anonymized_Story_Creation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/D3_Formal_Derivation"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b27"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b28"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b29"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b30"/>
    <dc:title xml:lang="en">Anonymized Story Creation</dc:title>
    <rdfs:comment xml:lang="en">Event in which an Anonymized Story is created as a formal derivation of a Story, using software based on an LLM.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Anonymized Story Creation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Glossing_Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Textual_Annotation"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b59"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b60"/>
    <dc:title xml:lang="en">Glossing Annotation</dc:title>
    <rdfs:comment xml:lang="en">Annotation whose body is the interlinear gloss of a segment of an Anonymized Story, based on the transcription of that segment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Glossing Annotation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b33">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/L23_used_software_or_firmware"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Praat"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b8">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <owl:withRestrictions rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b39">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/L48_created_annotation"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Translation_Annotation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/oa#TextualBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:title xml:lang="en">Textual Body</dc:title>
    <rdfs:comment xml:lang="en">Web Annotation class: an embedded textual resource used as the body of an Annotation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/oa#"/>
    <rdfs:label xml:lang="en">Textual Body</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Media_Segment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/oa#SpecificResource"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b65"/>
    <dc:title xml:lang="en">Media Segment</dc:title>
    <rdfs:comment xml:lang="en">Temporal segment of a time-based resource, identified by a media fragment selector. Generalises the segments of the Story and of the Anonymized Story.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Media Segment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Software_Based_On_LLM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/D14_Software"/>
    <dc:title xml:lang="en">LLM Software</dc:title>
    <rdfs:comment xml:lang="en">Software based on a Large Language Model (LLM), used to produce the Anonymized Story from the Story.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">LLM Software</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Anonymized_Story">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/D1_Digital_Object"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b19"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b20"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b21"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b22"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b23"/>
    <owl:disjointWith rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b24"/>
    <dc:title xml:lang="en">Anonymized Story</dc:title>
    <rdfs:comment>Anonymized version of the clipped story using AI techniques. Anonymization involves voice and body.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Anonymized Story</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b35">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/L23_used_software_or_firmware"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Storytel_AI_Assisted_Pipeline"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b81">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/oa#hasBody"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Transcription_Body"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b41">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Full_Video"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Annotation_Body">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:title xml:lang="en">Annotation Body</dc:title>
    <rdfs:comment>Content of an annotation. It is either textual (transcription, translation, glossing) or acoustic (output of the acoustic analysis).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Annotation Body</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Duration_Of_Full_Video">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E54_Dimension"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b43"/>
    <dc:title xml:lang="en">Duration of Full Video</dc:title>
    <rdfs:comment xml:lang="en">Dimension expressing the total duration of a Full Video, as an xsd:duration value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Duration of Full Video</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b68">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R76_is_derivative_of"/>
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Full_Video"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Student_Participant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
    <dc:title xml:lang="en">Student Participant</dc:title>
    <rdfs:comment xml:lang="en">Person, a student, who participates in a conversational storytelling session.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Student Participant</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b15">
    <rdf:first rdf:resource="http://www.purl.org/storytel/Anonymized_Story"/>
    <rdf:rest rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b16"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Story_Creation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b73"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b74"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b75"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b76"/>
    <dc:title xml:lang="en">Anonymized Video Creation</dc:title>
    <rdfs:comment xml:lang="en">Event in which an Anonymized Video is created by a anonymization pipeline based on LLMs.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Anonymized Video Creation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/language">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:title xml:lang="en">Language</dc:title>
    <rdfs:comment xml:lang="en">The language of the resource; used here to state the language in which the ontology is expressed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/elements/1.1/"/>
    <rdfs:label xml:lang="en">Language</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Acoustic_Annotation_Body">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/D1_Digital_Object"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Annotation_Body"/>
    <dc:title xml:lang="en">Acoustic Annotation Body</dc:title>
    <rdfs:comment xml:lang="en">Output of the acoustic analysis of a segment of the Story, stored as a digital object (e.g. an F0 data file or a waveform or spectrogram image) and not as text. Because it is computed on the non-anonymized voice it may allow speaker identification.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Acoustic Annotation Body</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b44">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P90_has_value"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Frequency_Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Acoustic_Annotation"/>
    <dc:title xml:lang="en">Frequency Annotation</dc:title>
    <rdfs:comment xml:lang="en">Acoustic annotation holding the Frequency of a segment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Frequency Annotation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Textual_Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Annotation"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b78"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b79"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b80"/>
    <dc:title xml:lang="en">Textual Annotation</dc:title>
    <rdfs:comment xml:lang="en">Annotation carrying text (transcription, translation or glossing) for a segment of an Anonymized Story.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Textual Annotation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:title xml:lang="en">Title</dc:title>
    <rdfs:comment xml:lang="en">A name given to the resource; used here to provide a human-readable title for ontology terms.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/elements/1.1/"/>
    <rdfs:label xml:lang="en">Title</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Automatic_Acoustic_Analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Automatic_Annotation"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b33"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b34"/>
    <dc:title xml:lang="en">Automatic Acoustic Analysis</dc:title>
    <rdfs:comment xml:lang="en">Automatic annotation event in which the pipeline runs Praat on a segment of the Story to produce acoustic annotations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Automatic Acoustic Analysis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Anonymized_Story_Segment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Media_Segment"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/oa#SpecificResource"/>
    <rdfs:subClassOf rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b31"/>
    <dc:title xml:lang="en">Segment of Anonymized Story</dc:title>
    <rdfs:comment>Temporal segment of an Anonymized Story, e.g. 00:12:03-00:12:47.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Segment of Anonymized Story</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/is_based_on_transcription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="nbe3a5c879a974bcb99a97f5216d30ae4b1"/>
    <rdfs:range rdf:resource="http://www.purl.org/storytel/Transcription_Annotation"/>
    <dc:title xml:lang="en">is based on transcription</dc:title>
    <rdfs:comment xml:lang="en">Links a translation or glossing annotation to the transcription annotation it was derived from.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">is based on transcription</rdfs:label>
  </rdf:Description>
