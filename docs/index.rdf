    <dc:title xml:lang="en">has body</dc:title>
    <rdfs:comment xml:lang="en">Web Annotation property linking an Annotation to the resource that carries its content (e.g. the transcribed text).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/oa#"/>
    <rdfs:label xml:lang="en">has body</rdfs:label>
  </rdf:Description>
