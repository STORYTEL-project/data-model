    <owl:disjointWith rdf:resource="http://www.purl.org/storytel/Textual_Annotation"/>
    <dc:title xml:lang="en">Acoustic Annotation</dc:title>
    <rdfs:comment xml:lang="en">Annotation holding the result of an acoustic analysis (Praat) of a segment of the Story. It is computed on the original, non-anonymized audio, so it may contain speaker-identifying information and should be handled according to the project data-protection policy.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Acoustic Annotation</rdfs:label>
  </rdf:Description>
