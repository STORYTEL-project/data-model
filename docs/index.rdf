  <rdf:Description rdf:about="http://www.purl.org/storytel/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://cidoc-crm.org/extensions/lrmoo/owl/1.0/"/>
    <owl:imports rdf:resource="http://www.cidoc-crm.org/cidoc-crm/owl/7.1.3/"/>
    <owl:imports rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/owl/5.0/"/>
    <dc:creator>Giorgia Crosilla</dc:creator>
    <dc:description>Storytel is the ontology of the european funded project Storytel. Its goal is to map the relationship between Full Video, Anonymized Video and Anonymized Story re-using existing ontologies and implementing some ad-hoc classes.</dc:description>
    <dc:language>English</dc:language>
    <dc:title>Storytel</dc:title>
    <rdfs:label>Storytel</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Start_Of_The_Full_Video">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E54_Dimension"/>
    <rdfs:subClassOf rdf:nodeID="nfb4366b93bd749b99262f6ca53882fdbb51"/>
