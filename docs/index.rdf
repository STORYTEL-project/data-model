    <rdfs:isDefinedBy rdf:resource="http://www.purl.org/storytel/"/>
    <rdfs:label xml:lang="en">Automatic Annotation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.purl.org/storytel/Anonymized_Story_Creation">
