  <rdf:Description rdf:about="http://www.purl.org/storytel/Acoustic_Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.purl.org/storytel/Annotation"/>
