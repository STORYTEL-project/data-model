@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dc:title a owl:AnnotationProperty ;
    rdfs:label "Title"@en ;
    dc:title "Title"@en ;
    rdfs:comment "A name given to the resource; used here to provide a human-readable title for ontology terms."@en ;
    rdfs:isDefinedBy dc: .

