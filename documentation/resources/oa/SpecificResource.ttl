@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

oa:SpecificResource a owl:Class ;
    rdfs:label "Specific Resource"@en ;
    dc:title "Specific Resource"@en ;
    rdfs:comment "Web Annotation class: a part or a particular state of a resource, identified through a source and a selector."@en ;
    rdfs:isDefinedBy oa: .

