    <dc:title xml:lang="en">Full Video Creation</dc:title>
    <rdfs:comment xml:lang="en">Event of recording a Full Video, carried out by a Student Recording with a Group of Participants, at a Place of Recording and on a Smartphone.</rdfs:comment>
    <rdfs:label xml:lang="en">Full Video Creation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n64c7f766f8394242a9af6b72fa234328b13">
    <owl:someValuesFrom rdf:resource="http://www.purl.org/storytel/Place_Of_Recording"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n64c7f766f8394242a9af6b72fa234328b10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R17_created"/>
