  </rdf:Description>
  <rdf:Description rdf:nodeID="n64c7f766f8394242a9af6b72fa234328b11">
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P11_had_participant"/>
