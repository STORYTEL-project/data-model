  </rdf:Description>
  <rdf:Description rdf:nodeID="n64c7f766f8394242a9af6b72fa234328b14">
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/extensions/crmdig/L12_happened_on_device"/>
